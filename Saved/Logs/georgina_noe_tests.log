def etape_02_force_core_assets():
    eal = unreal.EditorAssetLibrary()
    at = unreal.AssetToolsHelpers.get_asset_tools()
    
    # Sauvegarde préventive
    unreal.EditorLoadingAndSavingUtils.save_dirty_packages(True, True)

    target_base = "/Game/Project/Animations/Player"
    
    # [cite_start]Liste précise des fichiers critiques (Basée sur ListeDesDossiersDepart.txt [cite: 32-33])
    critical_assets = [
        # Squelette (Doit bouger en premier)
        ("/Game/Characters/Mannequins/Meshes/SK_Mannequin", target_base + "/Characters/Mannequins/Meshes"),
        ("/Game/Characters/Mannequins/Rigs/PA_Mannequin", target_base + "/Characters/Mannequins/Rigs"),
        # Les Maillages Skelettiques
        ("/Game/Characters/Mannequins/Meshes/SKM_Manny_Simple", target_base + "/Characters/Mannequins/Meshes"),
        ("/Game/Characters/Mannequins/Meshes/SKM_Quinn_Simple", target_base + "/Characters/Mannequins/Meshes")
    ]

    unreal.log("--- DÉBUT FORÇAGE CRITIQUE ---")

    for src, dst_folder in critical_assets:
        asset_name = src.split("/")[-1]
        final_path = dst_folder + "/" + asset_name

        if eal.does_asset_exist(src):
            asset_obj = eal.load_asset(src)
            
            # Création du dossier si nécessaire
            if not eal.does_directory_exist(dst_folder):
                eal.make_directory(dst_folder)

            # Consolidate (Fusion) si la destination existe déjà
            if eal.does_asset_exist(final_path):
                unreal.log(f"Fusion de {asset_name}...")
                dest_obj = eal.load_asset(final_path)
                at.consolidate_assets(dest_obj, [asset_obj])
            else:
                unreal.log(f"Déplacement de {asset_name}...")
                at.rename_assets([unreal.AssetRenameData(asset=asset_obj, new_package_path=dst_folder, new_name=asset_name)])

    # Sauvegarde IMMEDIATE
    unreal.EditorLoadingAndSavingUtils.save_dirty_packages(True, True)
    unreal.log("SCRIPT 2 TERMINÉ : Assets critiques sécurisés.")

etape_02_force_core_assets()

