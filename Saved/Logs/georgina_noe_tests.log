import os
import shutil
import stat

def script_04_nettoyage_intelligent():
    unreal.log("--- DÉBUT SCRIPT 4 : NETTOYAGE INTELLIGENT ---")
    
    # Libérer la mémoire
    unreal.SystemLibrary.collect_garbage()
    
    content_dir = unreal.Paths.convert_relative_path_to_full(unreal.Paths.project_content_dir())
    
    folders_to_clean = [
        "FirstPerson",
        "Characters",
        "LevelPrototyping",
        "Input"
    ]

    # Fonction de gestion d'erreur (Callback)
    def gestion_erreur(func, path, exc_info):
        # Si le fichier n'existe pas (ex: ._Meshes fantôme), on ignore
        if not os.path.exists(path):
            return
        # Si le fichier est en lecture seule, on le déverrouille
        if not os.access(path, os.W_OK):
            os.chmod(path, stat.S_IWRITE)
            func(path)
        else:
            unreal.log_warning(f"Problème suppression : {path}")

    for folder_name in folders_to_clean:
        full_path = os.path.join(content_dir, folder_name)
        
        if os.path.exists(full_path):
            # SÉCURITÉ : Vérification d'Assets Unreal restants
            has_assets = False
            for root, dirs, files in os.walk(full_path):
                for file in files:
                    if file.endswith(".uasset") or file.endswith(".umap"):
                        has_assets = True
                        break
                if has_assets: break
            
            if has_assets:
                unreal.log_error(f"❌ SUPPRESSION ANNULÉE : {folder_name} contient encore des .uasset.")
                continue

            # Suppression propre
            try:
                shutil.rmtree(full_path, onerror=gestion_erreur) 
                unreal.log(f"✅ Dossier nettoyé : {folder_name}")
            except Exception as e:
                unreal.log_error(f"Erreur : {e}")
        else:
            unreal.log(f"Déjà propre : {folder_name}")

    unreal.log("--- TERMINÉ ---")

script_04_nettoyage_intelligent()
